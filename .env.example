# Copy to .env and replace every value marked REPLACE_ME. Never commit .env.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

FASTAPI_ENV=development
PROJECT_NAME="Notify"

# Signs JWTs. At least 32 bytes. REPLACE_ME.
SECRET_KEY=REPLACE_ME

# Encrypts phone numbers, Meta tokens and Cliniko keys at rest: 32 random bytes, base64url.
#   python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Unset, a key is derived from SECRET_KEY: fine locally; set it before real data is stored.
# FIELD_ENCRYPTION_KEY=

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=REPLACE_ME

# Outgoing mail. Signup and invitations need it. Locally, Mailpit (compose.yml) on :1025, UI on :8025.
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres. Locally the compose database; in production the Neon Sydney project, connected as a
# member of notify_app (see HOW_TO_RUN.md), with migrations as the owner.
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
# MIGRATION_DATABASE_URL=postgresql://owner:REPLACE_ME@host/db

# The Next.js app: the only CORS origin and the base of every emailed link.
FRONTEND_HOST=http://localhost:3000

SEED_DEMO_TENANT=false
USERS_OPEN_REGISTRATION=true
RATE_LIMIT_ENABLED=true

# Booking reminders: the bearer token a scheduler sends to
# POST /api/v1/internal/booking-notifications/run. Unset keeps that endpoint off (404).
# BOOKING_NOTIFICATIONS_RUN_TOKEN=

# Next modules (unused until they land).
# REDIS_URL=redis://localhost:6379/0
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# ANTHROPIC_API_KEY=
